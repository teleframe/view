{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        // Environment setup & latest features
        "lib": ["ESNext"],
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "@telegram-markup/native",
        "types": ["bun"],
        "allowJs": true,

        // Monorepo direct source mapping to packages/native
        "paths": {
            "@telegram-markup/native": ["../../packages/native/lib/index.tsx"],
            "@telegram-markup/native/*": ["../../packages/native/lib/*"]
        },

        // Type checking & best practices
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,

        // Development runtime mode
        "noEmit": true
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules"]
}
