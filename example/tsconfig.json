{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        // Environment setup & latest features
        "lib": ["ESNext"],
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "@teleframe/view",
        "types": ["bun"],
        "allowJs": true,

        // Direct source mapping to @teleframe/view and workspace modules
        "paths": {
            "@native": ["../packages/native/lib/index.ts"],
            "@native/*": ["../packages/native/lib/*"],
            "@teleframe/view": ["../src/index.ts"],
            "@teleframe/view/native": ["../packages/native/lib/index.ts"],
            "@teleframe/view/jsx-runtime": ["../src/jsx-runtime.ts"],
            "@teleframe/view/jsx-dev-runtime": ["../src/jsx-dev-runtime.ts"],
            "@teleframe/view/native/jsx-runtime": ["../packages/native/lib/jsx-runtime.ts"],
            "@teleframe/view/native/jsx-dev-runtime": ["../packages/native/lib/jsx-dev-runtime.ts"]
        },

        // Type checking & best practices
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,

        // Development runtime mode
        "noEmit": true
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules"]
}
