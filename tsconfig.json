{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        // Environment setup & latest features
        "lib": ["ESNext"],
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "@telegram-markup/native",
        "types": ["bun"],
        "allowJs": true,

        // Monorepo workspace package aliases
        "paths": {
            "@telegram-markup/native": ["./packages/native/lib/index.tsx"],
            "@telegram-markup/native/*": ["./packages/native/lib/*"],
            "@telegram-markup/*": ["./packages/*/lib/index.tsx", "./packages/*/src/index.tsx"]
        },

        // Type checking & best practices
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,

        // Editor / Bun runtime dev mode
        "noEmit": true
    },
    "include": ["packages/**/*", "src/**/*"],
    "exclude": ["node_modules", "dist"]
}
