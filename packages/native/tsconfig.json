{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "paths": {
            "@native": ["./lib/index.ts"],
            "@native/*": ["./lib/*"],
            "@components": ["./lib/components/index.ts"],
            "@components/*": ["./lib/components/*"],
            "@tags": ["./lib/tags/index.ts"],
            "@tags/*": ["./lib/tags/*"],
            "@languages": ["./lib/tags/languages.ts"],
            "@sanitizer": ["./lib/sanitizer/index.ts"],
            "@sanitizer/*": ["./lib/sanitizer/*"],
            "@entities": ["./lib/entities/index.ts"],
            "@entities/*": ["./lib/entities/*"],
            "@validation": ["./lib/validation/index.ts"],
            "@validation/*": ["./lib/validation/*"],
            "@view/native": ["./lib/index.ts"],
            "@view/native/*": ["./lib/*"],
            "@teleframe/view": ["../../src/index.ts"],
            "@teleframe/view/native": ["./lib/index.ts"],
            "@teleframe/view/jsx-runtime": ["../../src/jsx-runtime.ts"],
            "@teleframe/view/jsx-dev-runtime": ["../../src/jsx-dev-runtime.ts"],
            "@teleframe/view/native/jsx-runtime": ["./lib/jsx-runtime.ts"],
            "@teleframe/view/native/jsx-dev-runtime": ["./lib/jsx-dev-runtime.ts"]
        }
    }
}
