{
    "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
    "name": "@teleframe/view",
    "version": "0.2.1",
    "unstable": [
        "sloppy-imports"
    ],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "@teleframe/view"
    },
    "publish": {
        "include": [
            "src",
            "packages/native/lib",
            "README.md",
            "LICENSE"
        ]
    },
    "imports": {
        "@native/jsx-runtime": "./packages/native/lib/jsx-runtime.ts",
        "@native/jsx-dev-runtime": "./packages/native/lib/jsx-dev-runtime.ts",
        "@native/": "./packages/native/lib/",
        "@native": "./packages/native/lib/index.ts",
        "@components/": "./packages/native/lib/components/",
        "@components": "./packages/native/lib/components/index.ts",
        "@tags/": "./packages/native/lib/tags/",
        "@tags": "./packages/native/lib/tags/index.ts",
        "@languages": "./packages/native/lib/tags/languages.ts",
        "@sanitizer/": "./packages/native/lib/sanitizer/",
        "@sanitizer": "./packages/native/lib/sanitizer/index.ts",
        "@entities/": "./packages/native/lib/entities/",
        "@entities": "./packages/native/lib/entities/index.ts",
        "@validation/": "./packages/native/lib/validation/",
        "@validation": "./packages/native/lib/validation/index.ts",
        "@view/native/jsx-runtime": "./packages/native/lib/jsx-runtime.ts",
        "@view/native/jsx-dev-runtime": "./packages/native/lib/jsx-dev-runtime.ts",
        "@view/native/": "./packages/native/lib/",
        "@view/native": "./packages/native/lib/index.ts",
        "@teleframe/view/native/jsx-runtime": "./packages/native/lib/jsx-runtime.ts",
        "@teleframe/view/native/jsx-dev-runtime": "./packages/native/lib/jsx-dev-runtime.ts",
        "@teleframe/view/native/": "./packages/native/lib/",
        "@teleframe/view/native": "./packages/native/lib/index.ts",
        "@teleframe/view/jsx-runtime": "./src/jsx-runtime.ts",
        "@teleframe/view/jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
        "@teleframe/view/": "./src/",
        "@teleframe/view": "./src/index.ts"
    },
    "exports": {
        ".": "./src/index.ts",
        "./native": "./packages/native/lib/index.ts",
        "./jsx-runtime": "./src/jsx-runtime.ts",
        "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
        "./native/jsx-runtime": "./packages/native/lib/jsx-runtime.ts",
        "./native/jsx-dev-runtime": "./packages/native/lib/jsx-dev-runtime.ts"
    },
    "tasks": {
        "build": "bun run build",
        "check": "deno check src/index.ts src/jsx-runtime.ts packages/native/lib/index.ts",
        "test": "deno test tests/deno.test.tsx",
        "verify": "bun scripts/verify-release.ts"
    }
}
